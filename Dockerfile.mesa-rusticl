# =============================================================================
# Dockerfile.mesa-rusticl
#
# Builds Mesa 26.1.4 with:
#   - rusticl OpenCL ICD (cl_khr_fp16 enabled for vega20 / Radeon Pro V340)
#   - RADV Vulkan driver (amd)
#   - Full GL stack: OpenGL, GLES 1/2, DRI-based GLX, EGL, GBM, via libglvnd
#   - Custom libclc (spirv-mesa3d targets, FP16 builtins)
#
# Multi-stage: builder produces /usr/local/mesa; runtime copies it in cleanly.
#
# Base: ubuntu:26.04 for BOTH stages. This matters — noble (24.04) ships
# meson 1.3.2 (Mesa needs >= 1.4), libdrm 2.4.120 (amdgpu needs >= 2.4.121),
# rustc 1.75 and bindgen 0.66 (both too old for rusticl in Mesa 26.x).
# The runtime base image MUST also be on 26.04 or the copied Mesa libs will
# fail to load on glibc symbol versions.
#
# Build:
#   docker build -f Dockerfile.mesa-rusticl -t mesa-rusticl:26.1.4 .
#   docker build --build-arg NATIVE=1 -f Dockerfile.mesa-rusticl -t mesa-rusticl:26.1.4-native .
#
# Run (GPU passthrough via ROCm/DRI device):
#   docker run --rm --device /dev/dri \
#     -e RUSTICL_ENABLE=radeonsi \
#     -e DRI_PRIME=0 \
#     mesa-rusticl:26.1.4 clinfo
#
# Verify fp16:
#   docker run --rm --device /dev/dri \
#     -e RUSTICL_ENABLE=radeonsi \
#     mesa-rusticl:26.1.4 clinfo | grep cl_khr_fp16
#
# Verify Vulkan:
#   docker run --rm --device /dev/dri \
#     -e VK_ICD_FILENAMES=/usr/local/mesa/share/vulkan/icd.d/radeon_icd.x86_64.json \
#     mesa-rusticl:26.1.4 vulkaninfo --summary
#
# Verify OpenGL / GLX (needs an X display):
#   docker run --rm --device /dev/dri -e DISPLAY=$DISPLAY \
#     -v /tmp/.X11-unix:/tmp/.X11-unix \
#     mesa-rusticl:26.1.4 glxinfo -B
#
# Verify EGL vendor resolution:
#   docker run --rm --device /dev/dri mesa-rusticl:26.1.4 eglinfo -B
#   docker run --rm mesa-rusticl:26.1.4 \
#     sh -c 'ldd $(which glxinfo) | grep -i gl'
# =============================================================================

ARG UBUNTU_VERSION=26.04
ARG MESA_VERSION=26.1.4
ARG MESA_SHA256=072705caa9adf4740f1489194b13e278ad959166863b5271fe423a86353c9ab6
# Newer point releases on the 26.1 branch, if you want to bump:
#   26.1.5  (2026-07-16)
#   26.1.6  5296b88a0f1e012e2cb9ada150a2bbadf728ca81e5a4fb2ab43c83a4d2158606
ARG MESA_PREFIX=/usr/local/mesa
# Runtime base — must be built on the same Ubuntu release as the builder
ARG RUNTIME_BASE=twobombs/thereminq-desktop
# Set NATIVE=1 at build time to enable -march=native
ARG NATIVE=0

# =============================================================================
# Stage 1: builder
# =============================================================================
FROM ubuntu:${UBUNTU_VERSION} AS builder

ARG MESA_VERSION
ARG MESA_SHA256
ARG MESA_PREFIX
ARG NATIVE

ENV DEBIAN_FRONTEND=noninteractive \
    TZ=UTC

# ---------------------------------------------------------------------------
# Phase 1: Detect LLVM version and install all build dependencies in one layer
# ---------------------------------------------------------------------------
RUN set -eux; \
    apt-get update -qq; \
    \
    # Probe for the highest available LLVM version
    LLVM_VER=""; \
    for v in 24 23 22 21 20 19 18 17 16 15; do \
        if apt-cache show "llvm-${v}-dev" >/dev/null 2>&1; then \
            LLVM_VER="${v}"; break; \
        fi; \
    done; \
    [ -n "${LLVM_VER}" ] || { echo "ERROR: No LLVM dev package found"; exit 1; }; \
    echo "Using LLVM ${LLVM_VER}"; \
    \
    # Core build tools
    apt-get install -y --no-install-recommends \
        curl ca-certificates xz-utils git cmake \
        meson ninja-build pkg-config \
        python3 python3-mako python3-yaml \
        gcc g++ bison flex libelf-dev \
        dpkg-dev; \
    \
    # LLVM / Clang
    apt-get install -y --no-install-recommends \
        "llvm-${LLVM_VER}-dev" \
        "libclang-${LLVM_VER}-dev" \
        "clang-${LLVM_VER}"; \
    \
    # libclang-cpp (name varies by distro version)
    if apt-cache show "libclang-cpp${LLVM_VER}-dev" >/dev/null 2>&1; then \
        apt-get install -y --no-install-recommends "libclang-cpp${LLVM_VER}-dev"; \
    elif apt-cache show "libclang-cpp-${LLVM_VER}-dev" >/dev/null 2>&1; then \
        apt-get install -y --no-install-recommends "libclang-cpp-${LLVM_VER}-dev"; \
    fi; \
    \
    # SPIRV-LLVM-Translator
    if apt-cache show "llvm-spirv-${LLVM_VER}" >/dev/null 2>&1; then \
        apt-get install -y --no-install-recommends "llvm-spirv-${LLVM_VER}"; \
        if [ ! -f /usr/bin/llvm-spirv ] && [ -f "/usr/bin/llvm-spirv-${LLVM_VER}" ]; then \
            ln -sf "/usr/bin/llvm-spirv-${LLVM_VER}" /usr/bin/llvm-spirv; \
        fi; \
    fi; \
    if apt-cache show "libllvmspirvlib-${LLVM_VER}-dev" >/dev/null 2>&1; then \
        apt-get install -y --no-install-recommends "libllvmspirvlib-${LLVM_VER}-dev"; \
    elif apt-cache show "libllvmspirvlib-dev" >/dev/null 2>&1; then \
        apt-get install -y --no-install-recommends "libllvmspirvlib-dev"; \
    fi; \
    \
    # libclc (package tree filler; overridden by our source build below)
    if apt-cache show "libclc-${LLVM_VER}-dev" >/dev/null 2>&1; then \
        apt-get install -y --no-install-recommends "libclc-${LLVM_VER}" "libclc-${LLVM_VER}-dev"; \
    elif apt-cache show "libclc-dev" >/dev/null 2>&1; then \
        apt-get install -y --no-install-recommends libclc-dev; \
    fi; \
    \
    # Rust
    apt-get install -y --no-install-recommends rustc cargo rustfmt; \
    if apt-cache show "bindgen" >/dev/null 2>&1; then \
        apt-get install -y --no-install-recommends bindgen; \
    elif apt-cache show "rust-bindgen" >/dev/null 2>&1; then \
        apt-get install -y --no-install-recommends rust-bindgen; \
    fi; \
    \
    # SPIR-V tools
    apt-get install -y --no-install-recommends spirv-tools; \
    if apt-cache show "spirv-tools-dev" >/dev/null 2>&1; then \
        apt-get install -y --no-install-recommends spirv-tools-dev; \
    fi; \
    if apt-cache show "spirv-headers" >/dev/null 2>&1; then \
        apt-get install -y --no-install-recommends spirv-headers; \
    fi; \
    if apt-cache show "libspirv-cross-c-shared-dev" >/dev/null 2>&1; then \
        apt-get install -y --no-install-recommends libspirv-cross-c-shared-dev; \
    fi; \
    \
    # Vulkan build deps
    apt-get install -y --no-install-recommends \
        libvulkan-dev \
        libvulkan1 \
        glslang-tools \
        glslang-dev \
        vulkan-tools; \
    if apt-cache show "vulkan-utility-libraries-dev" >/dev/null 2>&1; then \
        apt-get install -y --no-install-recommends vulkan-utility-libraries-dev; \
    elif apt-cache show "vulkan-validationlayers-dev" >/dev/null 2>&1; then \
        apt-get install -y --no-install-recommends vulkan-validationlayers-dev; \
    fi; \
    \
    # Wayland / XCB / Xlib WSI and GL platform deps.
    # Notes on the non-obvious ones:
    #   wayland-protocols        - not a dep of libwayland-dev
    #   libwayland-egl-backend-dev - required for the wayland EGL platform
    #   libxcb-sync-dev          - not pulled in by libxcb-dri3-dev
    #   libxcb-xfixes0-dev       - not pulled in by libxcb-dri3-dev
    #   libxrandr-dev            - REQUIRED by -Dplatforms=x11 (xlib-lease /
    #                              VK_EXT_acquire_xlib_display). Xlib-level
    #                              libXrandr, NOT xcb-randr; meson hard-fails
    #                              at meson.build:2283 without it.
    #   libxcb-keysyms1-dev      - keybind toggle in the Vulkan overlay layer
    #   libxcb-glx0-dev,
    #   libxxf86vm-dev,
    #   libxdamage-dev,
    #   libxfixes-dev            - DRI-based GLX
    #   libglvnd-dev             - required by -Dglvnd=true
    apt-get install -y --no-install-recommends \
        libwayland-dev \
        libwayland-egl-backend-dev \
        wayland-protocols \
        libglvnd-dev \
        libx11-xcb-dev \
        libxcb-dri3-dev \
        libxcb-glx0-dev \
        libxcb-keysyms1-dev \
        libxcb-present-dev \
        libxcb-randr0-dev \
        libxcb-shm0-dev \
        libxcb-sync-dev \
        libxcb-xfixes0-dev \
        libxdamage-dev \
        libxext-dev \
        libxfixes-dev \
        libxrandr-dev \
        libxshmfence-dev \
        libxxf86vm-dev; \
    \
    # DRM + misc (libudev-dev improves DRM device enumeration for radeonsi)
    apt-get install -y --no-install-recommends \
        libdrm-dev \
        libudev-dev \
        libzstd-dev zlib1g-dev libexpat1-dev \
        ocl-icd-opencl-dev \
        clinfo; \
    \
    rm -rf /var/lib/apt/lists/*; \
    \
    # Verify LLVM / llvm-spirv major version alignment
    LLVM_MAJOR=$("/usr/bin/llvm-config-${LLVM_VER}" --version 2>/dev/null | grep -oP '^\d+' || echo "?"); \
    SPIRV_MAJOR=$(llvm-spirv --version 2>/dev/null | grep -oP '\d+\.\d+' | head -1 | cut -d. -f1 || echo "?"); \
    if [ "${LLVM_MAJOR}" != "?" ] && [ "${SPIRV_MAJOR}" != "?" ] && [ "${LLVM_MAJOR}" != "${SPIRV_MAJOR}" ]; then \
        echo "ERROR: LLVM major (${LLVM_MAJOR}) != llvm-spirv major (${SPIRV_MAJOR})"; exit 1; \
    fi; \
    echo "LLVM_VER=${LLVM_VER}" > /tmp/llvm_ver.env

# ---------------------------------------------------------------------------
# Phase 1.1: Toolchain floor checks
# Fail loudly here rather than 200 lines into an opaque meson error.
#   meson   >= 1.4.0   (Mesa top-level meson.build)
#   libdrm  >= 2.4.121 (amdgpu: radeonsi + RADV)
#   rustc   >= 1.85    (rusticl MSRV tracks Debian stable)
# ---------------------------------------------------------------------------
RUN set -eux; \
    echo "--- toolchain versions ---"; \
    meson --version; \
    ninja --version; \
    rustc --version; \
    (bindgen --version || echo "bindgen: MISSING"); \
    pkg-config --modversion libdrm; \
    pkg-config --modversion libdrm_amdgpu; \
    echo "--------------------------"; \
    \
    ver_ge() { [ "$(printf '%s\n%s\n' "$2" "$1" | sort -V | head -1)" = "$2" ]; }; \
    \
    MESON_V=$(meson --version); \
    ver_ge "${MESON_V}" "1.4.0" || { echo "ERROR: meson ${MESON_V} < 1.4.0"; exit 1; }; \
    \
    DRM_V=$(pkg-config --modversion libdrm_amdgpu); \
    ver_ge "${DRM_V}" "2.4.121" || { echo "ERROR: libdrm_amdgpu ${DRM_V} < 2.4.121"; exit 1; }; \
    \
    RUST_V=$(rustc --version | awk '{print $2}'); \
    ver_ge "${RUST_V}" "1.85.0" || { echo "ERROR: rustc ${RUST_V} < 1.85.0 (rusticl MSRV)"; exit 1; }; \
    \
    command -v bindgen >/dev/null || { echo "ERROR: bindgen not on PATH"; exit 1; }

# ---------------------------------------------------------------------------
# Phase 1.5: Build custom libclc from source
# (Fixes distro libclc's missing FP16 builtins; targets spirv-mesa3d / spirv64-mesa3d)
# ---------------------------------------------------------------------------
RUN set -eux; \
    LLVM_VER=$(cat /tmp/llvm_ver.env | cut -d= -f2); \
    MESA_PREFIX="${MESA_PREFIX}"; \
    \
    LLVM_CFG="/usr/bin/llvm-config-${LLVM_VER}"; \
    [ -f "${LLVM_CFG}" ] || LLVM_CFG=$(command -v llvm-config); \
    CLANG_C="/usr/bin/clang-${LLVM_VER}"; \
    [ -f "${CLANG_C}" ]  || CLANG_C=$(command -v clang); \
    CLANG_CXX="/usr/bin/clang++-${LLVM_VER}"; \
    [ -f "${CLANG_CXX}" ] || CLANG_CXX=$(command -v clang++); \
    GCC_DIR=$(dirname "$(gcc -print-libgcc-file-name)"); \
    \
    mkdir -p /tmp/libclc-src; \
    cd /tmp/libclc-src; \
    git init -q; \
    git remote add origin https://github.com/llvm/llvm-project.git; \
    git config core.sparseCheckout true; \
    echo "libclc/" >> .git/info/sparse-checkout; \
    if ! git pull -q --depth=1 origin "release/${LLVM_VER}.x" 2>/dev/null; then \
        echo "WARNING: no release/${LLVM_VER}.x branch, falling back to main"; \
        git pull -q --depth=1 origin main; \
    fi; \
    \
    cd libclc; \
    mkdir build; cd build; \
    cmake -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX="${MESA_PREFIX}" \
        -DCMAKE_CXX_COMPILER="${CLANG_CXX}" \
        -DCMAKE_C_COMPILER="${CLANG_C}" \
        -DCMAKE_CXX_FLAGS="--gcc-install-dir=${GCC_DIR}" \
        -DCMAKE_C_FLAGS="--gcc-install-dir=${GCC_DIR}" \
        -DLLVM_CONFIG="${LLVM_CFG}" \
        -DLIBCLC_TARGETS_TO_BUILD="spirv-mesa3d-;spirv64-mesa3d-" \
        ..; \
    ninja -j"$(nproc)"; \
    ninja install; \
    rm -rf /tmp/libclc-src

# ---------------------------------------------------------------------------
# Phase 2-4: Fetch, configure, build, and install Mesa
#
# NOTE: meson setup pulls Rust crate subprojects (syn, quote, proc-macro2, ...)
# from wrapdb/crates.io. This step needs outbound network access.
# ---------------------------------------------------------------------------
RUN set -eux; \
    MESA_PREFIX="${MESA_PREFIX}"; \
    TARBALL="/tmp/mesa-${MESA_VERSION}.tar.xz"; \
    \
    curl -fsSL "https://archive.mesa3d.org/mesa-${MESA_VERSION}.tar.xz" -o "${TARBALL}"; \
    echo "${MESA_SHA256}  ${TARBALL}" | sha256sum -c -; \
    \
    mkdir -p /tmp/mesa-build; \
    tar -xJ -C /tmp/mesa-build --strip-components=1 -f "${TARBALL}"; \
    rm "${TARBALL}"; \
    \
    GCC_DIR=$(dirname "$(gcc -print-libgcc-file-name)"); \
    \
    export PKG_CONFIG_PATH="${MESA_PREFIX}/share/pkgconfig:${MESA_PREFIX}/lib/pkgconfig"; \
    export BINDGEN_EXTRA_CLANG_ARGS="--gcc-install-dir=${GCC_DIR}"; \
    \
    NATIVE_FLAGS=""; \
    if [ "${NATIVE}" = "1" ]; then \
        NATIVE_FLAGS="-Dc_args=-march=native -Dcpp_args=-march=native"; \
    fi; \
    \
    cd /tmp/mesa-build; \
    if ! meson setup builddir \
        --prefix="${MESA_PREFIX}" \
        --buildtype=release \
        -Db_ndebug=true \
        -Dgallium-drivers=radeonsi,llvmpipe,softpipe \
        -Dvulkan-drivers=amd \
        -Dplatforms=x11,wayland \
        -Dopengl=true \
        -Dgles1=enabled \
        -Dgles2=enabled \
        -Degl=enabled \
        -Dgbm=enabled \
        -Dglx=dri \
        -Dshared-glapi=enabled \
        -Ddri3=enabled \
        -Dglvnd=true \
        -Dglvnd-vendor-name=mesa \
        -Dgallium-rusticl=true \
        -Dgallium-rusticl-enable-drivers=radeonsi \
        -Dllvm=enabled \
        -Dshared-llvm=enabled \
        -Drust_std=2021 \
        -Dvulkan-layers=device-select,overlay \
        ${NATIVE_FLAGS}; then \
        echo "===== meson-log.txt ====="; \
        cat builddir/meson-logs/meson-log.txt || true; \
        exit 1; \
    fi; \
    \
    ninja -C builddir -j"$(nproc)"; \
    ninja -C builddir install; \
    rm -rf /tmp/mesa-build

# ---------------------------------------------------------------------------
# Phase 5: Register ICDs inside the builder image (paths baked in)
# ---------------------------------------------------------------------------
RUN set -eux; \
    MESA_PREFIX="${MESA_PREFIX}"; \
    LIB_ARCH=$(dpkg-architecture -qDEB_HOST_MULTIARCH); \
    ARCH=$(uname -m); \
    \
    # OpenCL ICD
    mkdir -p /etc/OpenCL/vendors; \
    ln -sf "${MESA_PREFIX}/etc/OpenCL/vendors/rusticl.icd" \
           /etc/OpenCL/vendors/mesa-261-rusticl.icd; \
    \
    # Vulkan ICD
    mkdir -p /etc/vulkan/icd.d; \
    RADV_ICD="${MESA_PREFIX}/share/vulkan/icd.d/radeon_icd.${ARCH}.json"; \
    [ -f "${RADV_ICD}" ] && \
        ln -sf "${RADV_ICD}" /etc/vulkan/icd.d/mesa-261-radv.json || \
        echo "WARNING: RADV ICD JSON not found at ${RADV_ICD}"; \
    \
    # Vulkan explicit layers (dir is always created so the COPY below can't fail)
    mkdir -p /etc/vulkan/explicit_layer.d; \
    LAYER_SRC="${MESA_PREFIX}/share/vulkan/explicit_layer.d"; \
    if [ -d "${LAYER_SRC}" ]; then \
        for f in "${LAYER_SRC}"/*.json; do \
            [ -f "$f" ] || continue; \
            ln -sf "$f" "/etc/vulkan/explicit_layer.d/$(basename "$f")"; \
        done; \
    fi; \
    \
    # glvnd EGL vendor registration.
    # With -Dglvnd=true Mesa builds libEGL_mesa.so.0 / libGLX_mesa.so.0 rather
    # than libEGL.so.1 / libGL.so.1 — the loaders come from libglvnd. The EGL
    # vendor JSON tells libEGL which vendor library to dlopen.
    mkdir -p /etc/glvnd/egl_vendor.d; \
    EGL_JSON="${MESA_PREFIX}/share/glvnd/egl_vendor.d/50_mesa.json"; \
    if [ -f "${EGL_JSON}" ]; then \
        ln -sf "${EGL_JSON}" /etc/glvnd/egl_vendor.d/40_mesa-custom.json; \
    else \
        echo "WARNING: glvnd EGL vendor JSON not found at ${EGL_JSON}"; \
    fi; \
    \
    # ldconfig
    echo "${MESA_PREFIX}/lib/${LIB_ARCH}" > /etc/ld.so.conf.d/mesa-rusticl.conf; \
    ldconfig

# =============================================================================
# Stage 2: runtime
# Lean image: only the Mesa install + runtime libs, no build tools.
# The base MUST be built on ubuntu:26.04 to match the builder's glibc.
# =============================================================================
FROM ${RUNTIME_BASE} AS runtime

ARG MESA_PREFIX
ARG MESA_VERSION

ENV DEBIAN_FRONTEND=noninteractive \
    TZ=UTC

# Fail fast if the runtime base is not on the same Ubuntu release as the builder
RUN set -eux; \
    . /etc/os-release; \
    echo "runtime base: ${PRETTY_NAME}"; \
    [ "${VERSION_ID}" = "26.04" ] || { \
        echo "ERROR: runtime base is Ubuntu ${VERSION_ID}, expected 26.04."; \
        echo "Mesa libs built on 26.04 will not load against an older glibc."; \
        exit 1; \
    }

# Runtime deps: OpenCL loader, Vulkan loader, glvnd GL loaders, DRM, X/Wayland.
# The glvnd loaders (libGL/libGLX/libEGL/libGLES) come from the distro; the
# vendor implementations (libGLX_mesa, libEGL_mesa) come from our build.
RUN apt-get update -qq && \
    apt-get install -y --no-install-recommends \
        ocl-icd-libopencl1 \
        libvulkan1 \
        vulkan-tools \
        libglvnd0 \
        libgl1 \
        libglx0 \
        libegl1 \
        libgles2 \
        libopengl0 \
        mesa-utils \
        libdrm-amdgpu1 \
        libudev1 \
        libzstd1 \
        libexpat1 \
        libelf1 \
        clinfo \
        libwayland-client0 \
        libwayland-server0 \
        libwayland-egl1 \
        libx11-6 \
        libxcb1 \
        libxcb-glx0 \
        libxcb-dri3-0 \
        libxcb-present0 \
        libxcb-randr0 \
        libxcb-shm0 \
        libxcb-sync1 \
        libxcb-xfixes0 \
        libxdamage1 \
        libxext6 \
        libxfixes3 \
        libxrandr2 \
        libxshmfence1 \
        libxxf86vm1 && \
    rm -rf /var/lib/apt/lists/*

# Copy the Mesa install tree from builder
COPY --from=builder ${MESA_PREFIX} ${MESA_PREFIX}

# Copy ICD registrations
COPY --from=builder /etc/OpenCL/vendors/mesa-261-rusticl.icd \
                    /etc/OpenCL/vendors/mesa-261-rusticl.icd
COPY --from=builder /etc/vulkan/icd.d/mesa-261-radv.json \
                    /etc/vulkan/icd.d/mesa-261-radv.json
COPY --from=builder /etc/vulkan/explicit_layer.d \
                    /etc/vulkan/explicit_layer.d
COPY --from=builder /etc/glvnd/egl_vendor.d \
                    /etc/glvnd/egl_vendor.d
COPY --from=builder /etc/ld.so.conf.d/mesa-rusticl.conf \
                    /etc/ld.so.conf.d/mesa-rusticl.conf

RUN ldconfig

# Runtime environment.
# ld.so.conf already puts our lib dir on the global search path, so
# libGLX_mesa / libEGL_mesa / libgbm from this build take precedence over the
# base image's distro Mesa. __EGL_VENDOR_LIBRARY_DIRS points glvnd at our EGL
# vendor JSON; LIBGL_DRIVERS_PATH and GBM_BACKENDS_PATH point at our DRI and
# GBM modules rather than the distro ones.
ENV RUSTICL_ENABLE=radeonsi \
    DRI_PRIME=0 \
    LD_LIBRARY_PATH=${MESA_PREFIX}/lib/x86_64-linux-gnu \
    LIBGL_DRIVERS_PATH=${MESA_PREFIX}/lib/x86_64-linux-gnu/dri \
    GBM_BACKENDS_PATH=${MESA_PREFIX}/lib/x86_64-linux-gnu/gbm \
    __EGL_VENDOR_LIBRARY_DIRS=${MESA_PREFIX}/share/glvnd/egl_vendor.d \
    VK_ICD_FILENAMES=${MESA_PREFIX}/share/vulkan/icd.d/radeon_icd.x86_64.json

LABEL org.opencontainers.image.title="Mesa ${MESA_VERSION} rusticl+fp16 + RADV Vulkan" \
      org.opencontainers.image.description="Mesa rusticl OpenCL (cl_khr_fp16) and RADV Vulkan for vega20 / Radeon Pro V340"
